{
  "name": "@ref0/ci-doctor",
  "version": "0.1.0",
  "description": "Score GitHub Actions CI from 0 to 100 on your machine, see what to fix first, and find ci-doctor's playbook and coding-agent skills.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ci-doctor": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ref-0/ci-doctor.git",
    "directory": "scorer"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "homepage": "https://ci-doctor.ref0.dev/",
  "keywords": [
    "ci",
    "continuous-integration",
    "github-actions",
    "ci-performance",
    "ci-scoring",
    "coding-agents"
  ]
}
