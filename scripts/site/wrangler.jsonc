{
  "$schema": "https://unpkg.com/wrangler@4.165.0/config-schema.json",
  // The guide on ci.ref0.dev: static assets only, no Worker code. Build it first with
  // `node scripts/site/build.ts`; README.md, beside this file, says how to deploy it.
  "name": "ci-doctor-guide",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../../dist/site",
    // /guide/scripts/local redirects to /guide/scripts/local/, which serves that folder's index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  // Only these paths: the rest of ci.ref0.dev, such as /<owner>/<repo>, is the score site's.
  "routes": [
    { "pattern": "ci.ref0.dev/guide/*", "zone_name": "ref0.dev" },
    { "pattern": "ci.ref0.dev/llms.txt", "zone_name": "ref0.dev" },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
